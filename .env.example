# ---------- Modelo de visión ----------
VLM_BACKEND=ollama
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen3-vl:8b-instruct
# schema = salida JSON restringida (Qwen3-VL, Qwen3.5); plantilla = la plantilla va en el prompt (GLM-OCR)
VLM_FORMATO=schema
VLM_TIMEOUT_S=180
VLM_MAX_SIDE=1600
VLM_NUM_CTX=8192
# Qwen3.5 "piensa" por defecto; apagarlo: VLM_THINK=false
# VLM_THINK=false
VLM_LOCALIZADOR=true

# ---------- Documento ----------
RENDER_DPI=250
MAX_PAGINAS_DOCUMENTO=15
SOLO_PDF=true
RECHAZAR_NO_PASAPORTE=true

# ---------- Formato de la respuesta ----------
# propio = formato original de este servicio; homologado = contrato de la API de referencia
# (docs/HOMOLOGACION_PASAPORTE.md). El motor es el mismo en los dos.
FORMATO_RESPUESTA=homologado
# Sólo en homologado. false (regla de la referencia): datos lleva la lectura impresa y si difiere de la
# MRZ es discrepancia (210). true: la MRZ manda cuando su dígito verificador la respalda (aviso, 211).
MRZ_MANDA=false
# Plan de atención: anio = vigente si el año de vencimiento es >= al actual (lo que pide el plan);
# fecha = la fecha de vencimiento es hoy o posterior. datos.vigente usa la misma regla.
REGLA_VIGENCIA=anio
# Leer el sello de cotejo (FECHA, REVISÓ, clave). Vacío = sólo en modo homologado.
# LEER_SELLO=

# ---------- API ----------
MAX_CONCURRENT_JOBS=2
# Si se define, POST /pasaporte exige el header X-API-Key con este valor (401 si falta o no coincide)
# API_KEY=cambia-esto
ENABLE_DOCS=true

# ---------- Docker (servidor) ----------
API_PORT=18474
# Ollama compartido con ine-ocr (misma GPU de 8 GB: un solo modelo cargado):
#   VLM_BASE_URL=http://ollama:11434
#   OLLAMA_NETWORK=ine-ocr_default
#   OLLAMA_NETWORK_EXTERNAL=true
# Ollama propio: docker compose --profile ollama up -d --build (deja OLLAMA_NETWORK sin definir)
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
LOTE_DIR=./lote
